# Anthropic API key — Claude powers both topic-shift detection and CRM entity extraction.
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API key — Whisper transcription only.
# Required when WHISPER_BACKEND=openai (the default). Not needed for WHISPER_BACKEND=local.
OPENAI_API_KEY=sk-...

# ---------------------------------------------------------------------------
# Salesforce External Client App (ECA) + Hosted MCP Server
# ---------------------------------------------------------------------------
# 1. In Salesforce Setup, go to External Client Apps → New External Client App.
# 2. Enable OAuth, add the callback URL: http://localhost:8000/oauth/callback
#    (change the port to match PORT below if you customise it).
# 3. Enable PKCE ("Require Proof Key for Code Exchange").
# 4. Add scopes: api  refresh_token  offline_access
# 5. For a public ECA leave SF_CLIENT_SECRET blank — PKCE proves identity.
#    For a confidential ECA fill in the consumer secret as well.
# 6. In Setup → MCP Servers, copy the Streamable-HTTP endpoint URL of the
#    Hosted Salesforce MCP Server into SF_MCP_SERVER_URL below.
SF_CLIENT_ID=3MVG9...your_external_client_app_consumer_key...

# Optional — only set this for confidential ECAs. Public ECAs leave it blank.
# SF_CLIENT_SECRET=

# Salesforce Hosted MCP Server endpoint (Streamable HTTP). REQUIRED.
SF_MCP_SERVER_URL=https://your-org.salesforce.com/services/mcp/streamable

# OAuth scopes requested at authorize time. Override only if your ECA needs more.
# SF_MCP_SCOPES=api refresh_token offline_access

# Salesforce login URL.
# Use "https://login.salesforce.com" for production orgs (default).
# Use "https://test.salesforce.com" for sandboxes.
# SF_LOGIN_URL=https://login.salesforce.com

# Fernet encryption key used to encrypt OAuth tokens stored in meetings.db.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
# Keep this secret — changing it will invalidate all stored tokens.
ENCRYPTION_KEY=your_64_char_hex_string_here

# Server settings (optional)
HOST=127.0.0.1
PORT=8000

# Audio capture settings (optional)
# Length of each audio chunk sent to Whisper, in seconds
AUDIO_CHUNK_SECONDS=5
# Microphone sample rate
AUDIO_SAMPLE_RATE=16000

# ---------------------------------------------------------------------------
# Transcription backend (optional — defaults to "openai")
# ---------------------------------------------------------------------------
# Set to "local" to run Whisper entirely on-device with faster-whisper.
# No audio data leaves your machine when using the local backend.
# Requires:  pip install faster-whisper
#
# WHISPER_BACKEND=openai

# Model size for the local backend.
# Options: tiny | base | small | medium | large-v2 | large-v3
# Larger models are more accurate but slower and use more RAM.
# "base" is a good starting point for most laptops (CPU inference).
#
# LOCAL_WHISPER_MODEL=base

# Device for the local backend: "cpu" (default) or "cuda" (NVIDIA GPU).
#
# LOCAL_WHISPER_DEVICE=cpu

# Compute type for faster-whisper quantisation.
# "int8" (default) is best for CPU. Use "float16" for GPU.
#
# LOCAL_WHISPER_COMPUTE_TYPE=int8

# ---------------------------------------------------------------------------
# Operational hardening (optional)
# ---------------------------------------------------------------------------
# Logging verbosity. One of: DEBUG | INFO | WARNING | ERROR
# Each log line carries a per-chunk request_id so you can trace a single
# audio chunk through transcribe → topic → entities → Salesforce.
#
# LOG_LEVEL=INFO

# Salesforce session idle timeout in minutes. After this much idle time
# the next CRM query proactively refreshes the OAuth token, avoiding
# stale-token errors during long meetings.
#
# SF_SESSION_TIMEOUT_MINUTES=30

# Maximum seconds to wait for any single Salesforce Hosted MCP Server
# request (warm-up, SOQL query, describe). If the MCP server hangs —
# network drop, Salesforce maintenance, or a misconfigured endpoint —
# the request is cancelled, the dashboard's red Salesforce-offline
# banner shows "Salesforce MCP server timed out", and CRM data falls
# back to empty instead of the UI spinning forever. Must be a positive
# number; defaults to 30 seconds.
#
# SF_MCP_TIMEOUT_SECONDS=30

# Skip the Anthropic credential ping at startup. Useful when developing
# offline or running without real credentials. SF_MCP_SERVER_URL is also
# treated as optional when this flag is set.
#
# SKIP_STARTUP_VALIDATION=0
